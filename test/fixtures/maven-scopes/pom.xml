<?xml version="1.0" encoding="UTF-8"?>
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>scope-app</artifactId>
  <version>1.0.0</version>
  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>compile-lib</artifactId>
      <version>1.2.3</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>runtime-lib</artifactId>
      <version>1.0.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>provided-lib</artifactId>
      <version>1.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>system-lib</artifactId>
      <version>1.0.0</version>
      <scope>system</scope>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>unscoped-lib</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>test-case-lib</artifactId>
      <version>1.1.0</version>
      <scope> TEST </scope>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>optional-lib</artifactId>
      <version>2.0.0</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>optional-text-lib</artifactId>
      <version>2.1.0</version>
      <optional>TRUE</optional>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>optional-false-lib</artifactId>
      <version>3.0.0</version>
      <scope>compile</scope>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>managed-test-lib</artifactId>
        <version>9.0.0</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>managed-optional-lib</artifactId>
        <version>8.0.0</version>
        <optional>true</optional>
      </dependency>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>bom-import</artifactId>
        <version>7.0.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Same coordinate as the direct compile row. The direct entry wins. -->
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>compile-lib</artifactId>
        <version>9.9.9</version>
        <scope>test</scope>
        <optional>true</optional>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
